{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remoteops.claryel.space/schemas/desired-state.schema.json",
  "title": "CLARYEL RemoteOps desired state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "device", "policies"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
        "platform": {"enum": ["windows", "linux", "macos"]},
        "profile": {"type": "string", "maxLength": 80}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval", "rollback"],
      "properties": {
        "approval": {"enum": ["risk-based", "always"]},
        "rollback": {"enum": ["required"]},
        "maintenanceWindow": {"type": "string", "maxLength": 120}
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,80}$"},
          "state": {"enum": ["enabled", "disabled"]}
        }
      }
    }
  }
}
